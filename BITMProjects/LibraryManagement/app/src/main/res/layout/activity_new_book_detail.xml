<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.nizamuddinshamrat.librarymanagement.BookDetailActivity"
    android:orientation="vertical"
    >
    <TextView
        android:id="@+id/bookNameTV"
        android:layout_marginTop="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30dp"
        android:textStyle="bold"
        tools:text="The Big Bang Theory"
        android:textColor="@color/black"
        android:layout_gravity="center"
        />

    <TextView
        android:id="@+id/bookIdTV"
        android:layout_gravity="center"
        android:textStyle="italic"
        android:textColor="@color/black"
        tools:text="Book ID: 1111"
        android:textSize="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <TextView
        android:id="@+id/bookWriterTV"
        android:layout_gravity="center"
        android:textStyle="italic"
        android:textColor="@color/black"
        tools:text="Stephen Hawking"
        android:textSize="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <TextView
        android:id="@+id/bookCatagoryTV"
        android:layout_gravity="center"
        android:textStyle="italic"
        android:textColor="@color/black"
        tools:text="Science"
        android:textSize="20dp"
        android:layout_below="@+id/bookWriterTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <TextView
        android:id="@+id/bookLanguageTV"
        android:layout_gravity="center"
        android:textStyle="italic"
        android:textColor="@color/black"
        tools:text="English"
        android:textSize="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />


<Button
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginTop="20dp"
    android:text="Download this book"
    />


</LinearLayout>
