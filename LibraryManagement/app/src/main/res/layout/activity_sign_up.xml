<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.nizamuddinshamrat.librarymanagement.SignUpActivity"
    android:background="@color/redlight"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    >
    <EditText
        android:id="@+id/nameEt"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Enter Your Name"
        android:gravity="center"
        android:background="@drawable/corner"
        android:backgroundTint="@color/white"
        />
    <RadioGroup
        android:layout_marginTop="20dp"
        android:id="@+id/genderRG"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/corner"
        android:gravity="center"
        android:backgroundTint="@color/white"
        >
        <RadioButton
            android:id="@+id/male"
            android:text="Male"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <RadioButton
            android:id="@+id/female"
            android:text="Female"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </RadioGroup>
    <EditText
        android:layout_marginTop="20dp"
        android:id="@+id/birthdayDateET"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:onClick="birthdayDate"
        android:hint="Birthday Date"
        android:focusable="false"
        android:gravity="center"
        android:background="@drawable/corner"
        android:backgroundTint="@color/white"

        />

    <EditText
        android:layout_marginTop="20dp"
        android:id="@+id/emailEtS"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Enter Your Email"
        android:gravity="center"
        android:background="@drawable/corner"
        android:backgroundTint="@color/white"
        />
    <EditText
        android:layout_marginTop="20dp"
        android:id="@+id/passwordEtS"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Enter Your Password"
        android:gravity="center"
        android:background="@drawable/corner"
        android:backgroundTint="@color/white"
        />
    <EditText
        android:layout_marginTop="20dp"
        android:id="@+id/confirmPasswordEtS"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Confirm Password"
        android:gravity="center"
        android:background="@drawable/corner"
        android:backgroundTint="@color/white"
        />

    <Button
        android:onClick="signUp"
        android:id="@+id/signUpBtn"
        android:layout_marginTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign Up"
        android:background="@drawable/corner"
        android:backgroundTint="@color/white"
        />

</LinearLayout>
